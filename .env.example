# Alpaca paper trading credentials (https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Local database connection string
# Postgres example:
# DATABASE_URL=postgresql://user:pass@localhost:5432/tradingbot
# Lightweight local fallback (use an absolute path):
DATABASE_URL=sqlite:////full/path/to/tradingbot.db

# Strategy parameters (12-1 momentum: trailing 12 months, skipping the most recent month)
LOOKBACK_MONTHS=12
SKIP_MONTHS=1
TOP_N=5
